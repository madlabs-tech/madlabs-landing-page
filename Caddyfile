# In-container file server (see Dockerfile). TLS, compression and security
# headers belong to the edge Caddy on the box (hryer/vps-infra), not here.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	# Hashed build output never changes under the same name.
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}.html {path}/index.html
	file_server
}
